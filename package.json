{
  "name": "sgiant-ai-agent-bridge",
  "version": "1.2.0",
  "description": "Make any web page AI-operable over postMessage \u2014 same-origin or cross-origin. Framework-agnostic, zero dependencies.",
  "license": "MIT",
  "keywords": [
    "ai",
    "agent",
    "postmessage",
    "iframe",
    "dom",
    "automation",
    "browser",
    "llm",
    "tool-use"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vedatugur/sgiant-ai-agent-bridge.git"
  },
  "homepage": "https://github.com/vedatugur/sgiant-ai-agent-bridge#readme",
  "bugs": {
    "url": "https://github.com/vedatugur/sgiant-ai-agent-bridge/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest-entry.d.ts",
      "default": "./dist/manifest-entry.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "audit": "./scripts/audit-tarball.sh",
    "prepublishOnly": "npm run build && npm run audit",
    "test": "npm run build && node --test \"tests/*.test.ts\""
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
