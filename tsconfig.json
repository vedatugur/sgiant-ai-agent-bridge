{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    // INLINED, not extended. This used to read `@sgiant/tsconfig/base.json`,
    // which is published to a private registry — a public repo that extends it
    // does not build for anyone outside the group, which is the whole point of
    // being here. The settings below are that preset, plus this package's own.
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "composite": true,
    "incremental": true,
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
